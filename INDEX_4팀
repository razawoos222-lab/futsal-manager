<!DOCTYPE html>
<html lang="ko">
<head>
    <base target="_top">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0">
    <title>JMFC 풋살 매니저</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;600;700;900&family=Cinzel:wght@700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f0f0f2; --elevated: #fff; --card: #fff;
            --border: #c4c4c8; --border-strong: #a1a1aa;
            --text: #18181b; --muted: #52525b;
            --primary: #2563eb; --primary-dark: #1d4ed8;
            --green: #16a34a; --green-dark: #15803d;
            --red: #dc2626; --blue: #2563eb;
            --yellow: #eab308; --yellow-text: #ca8a04; --yellow-border: #eab308;
            --gold: #c9a227; --gold-light: #f5e6b8;
            --neon: #a3e635; --sub: #7c3aed; --sub-dark: #6d28d9;
            --role-pivo: #8b5cf6; --role-fixo: #3b82f6; --role-ala: #f59e0b; --role-all: #14b8a6;
            --font-player: 1.125rem; --font-btn: 0.9375rem;
            --pcard-h: 76px; --touch-min: 48px; --input-h: 44px;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Noto Sans KR', sans-serif;
            background: var(--bg); color: var(--text);
            padding: 0.75rem 0.75rem 2.5rem;
            -webkit-tap-highlight-color: transparent;
        }
        .hidden { display: none !important; }
        #app { max-width: 400px; margin: 0 auto; }
        .screen { border-radius: 24px; border: 1.5px solid var(--border-strong); background: var(--elevated); overflow: hidden; box-shadow: 0 16px 48px rgba(0,0,0,0.08); }
        .jmfc-bar { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: #fff; border-bottom: 1.5px solid var(--border); }
        .logo-text { width: 38px; height: 38px; flex-shrink: 0; border-radius: 10px; background: linear-gradient(135deg, #1d4ed8, #2563eb); color: #fff; font-family: Cinzel, Georgia, serif; font-weight: 900; font-size: 0.75rem; display: flex; align-items: center; justify-content: center; letter-spacing: 0.04em; }
        .jmfc-brand { flex: 1; min-width: 0; }
        .jmfc-brand strong { display: block; font-family: Cinzel, Georgia, serif; font-size: 0.82rem; font-weight: 900; letter-spacing: 0.06em; }
        .jmfc-brand span { display: block; font-size: 0.68rem; color: var(--muted); font-weight: 600; margin-top: 1px; }
        .btn-back { width: 36px; height: 36px; border-radius: 10px; border: 1.5px solid var(--border); background: #fafafa; font-size: 1.1rem; font-weight: 900; color: var(--muted); cursor: pointer; flex-shrink: 0; }
        .body { padding: 12px 14px 16px; }
        .body.scroll { max-height: calc(100vh - 120px); overflow-y: auto; }
        h2 { font-size: 1.1rem; font-weight: 900; margin-bottom: 10px; }
        .lbl-sm { font-size: 0.78rem; font-weight: 700; color: var(--muted); display: block; margin-bottom: 4px; }
        .card { background: var(--card); border-radius: 12px; padding: 12px; border: 1.5px solid var(--border); margin-bottom: 10px; }
        .field, select.field, input.field { width: 100%; min-height: var(--touch-min); padding: 10px 12px; border-radius: 10px; font-size: var(--font-btn); border: 1.5px solid var(--border); background: #fafafa; font-family: inherit; font-weight: 700; }
        .btn-cta { width: 100%; min-height: var(--touch-min); padding: 12px; margin-top: 8px; border: none; border-radius: 12px; font-weight: 900; font-size: var(--font-btn); color: #fff; background: var(--primary); font-family: inherit; box-shadow: 0 2px 8px rgba(37,99,235,0.25); cursor: pointer; }
        .btn-cta:disabled { opacity: 0.45; cursor: not-allowed; }
        .btn-green { width: 100%; min-height: var(--touch-min); padding: 12px; border: none; border-radius: 12px; font-weight: 900; font-size: var(--font-btn); color: #fff; background: var(--green); font-family: inherit; cursor: pointer; }
        .btn-outline { width: 100%; min-height: var(--touch-min); padding: 12px; margin-top: 6px; border: 1.5px solid var(--border-strong); border-radius: 12px; background: #fff; font-weight: 800; font-size: var(--font-btn); font-family: inherit; cursor: pointer; }
        .btn-sec { width: 100%; min-height: var(--touch-min); padding: 12px; margin-top: 6px; border-radius: 12px; border: 1.5px solid var(--border); background: #fafafa; color: var(--muted); font-weight: 700; font-size: var(--font-btn); font-family: inherit; cursor: pointer; }
        .btn-danger { width: 100%; min-height: var(--touch-min); padding: 12px; margin-top: 8px; border: none; border-radius: 12px; font-weight: 900; font-size: var(--font-btn); font-family: inherit; color: #fff; background: #991b1b; cursor: pointer; }
        .t-red { color: var(--red); } .t-blue { color: var(--blue); } .t-yellow { color: var(--yellow-text); } .t-black { color: #18181b; }
        .team-name-RED { color: var(--red) !important; }
        .team-name-BLUE { color: var(--blue) !important; }
        .team-name-YELLOW { color: var(--yellow-text) !important; }
        .team-name-BLACK { color: #18181b !important; }
        .seg { display: flex; margin-bottom: 10px; border: 1.5px solid var(--border); border-radius: 10px; overflow: hidden; }
        .seg button { flex: 1; min-height: 44px; border: none; background: #fafafa; font-weight: 800; font-size: 0.85rem; font-family: inherit; color: var(--muted); cursor: pointer; }
        .seg button.on { background: var(--primary); color: #fff; }
        .chip-row { display: flex; gap: 6px; margin-bottom: 10px; flex-wrap: wrap; }
        .chip { padding: 6px 10px; border-radius: 8px; background: #f4f4f5; border: 1.5px solid var(--border); font-size: 0.75rem; font-weight: 700; cursor: pointer; }
        .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 10px; }
        .pcard { border-radius: 10px; border: 2px solid var(--role-fixo); padding: 8px 6px; background: #fafafa; position: relative; min-height: var(--pcard-h); display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; }
        .pcard.pivo { border-color: var(--role-pivo); } .pcard.ala { border-color: var(--role-ala); } .pcard.all { border-color: var(--role-all); }
        .pcard.selected { border-color: #16a34a; background: linear-gradient(160deg, #f0fdf4 0%, #ecfdf5 100%); box-shadow: 0 0 0 3px rgba(22,163,74,0.28); }
        .pcard.selected::after { content: '✓'; position: absolute; top: 5px; right: 5px; width: 20px; height: 20px; border-radius: 50%; background: #16a34a; color: #fff; font-size: 0.62rem; font-weight: 900; display: flex; align-items: center; justify-content: center; }
        .grid2.attend .pcard:not(.selected) { opacity: 0.68; }
        .pcard .name { font-weight: 800; font-size: 0.95rem; text-align: center; line-height: 1.2; }
        .pcard .role { text-align: center; font-size: 0.68rem; font-weight: 700; color: var(--muted); margin-top: 3px; }
        .pcard .stats { text-align: center; font-size: 0.65rem; color: var(--blue); font-weight: 700; margin-top: 2px; }
        .pcard .stats.empty { visibility: hidden; }
        .pcard.tap-pick { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,0.35); opacity: 1; }
        .coach-slots { display: flex; gap: 6px; margin-bottom: 10px; }
        .coach-slot { flex: 1; min-height: 52px; border-radius: 10px; border: 2px dashed var(--border-strong); display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 800; color: var(--muted); padding: 4px; cursor: pointer; }
        .coach-slot.filled-red { border-style: solid; border-color: var(--red); background: #fef2f2; color: var(--red); }
        .coach-slot.filled-blue { border-style: solid; border-color: var(--blue); background: #eff6ff; color: var(--blue); }
        .coach-slot.filled-yellow { border-style: solid; border-color: var(--yellow-border); background: #fffbeb; color: var(--yellow-text); }
        .coach-slot.filled-black { border-style: solid; border-color: #18181b; background: #f4f4f5; color: #18181b; }
        .coach-slot.pick-target { border-color: var(--blue); border-style: solid; box-shadow: 0 0 0 3px rgba(37,99,235,0.2); background: #eff6ff; }
        .coach-slot .slot-name { font-size: 0.75rem; font-weight: 900; margin-top: 2px; }
        .steps { font-size: 0.72rem; line-height: 1.5; padding: 10px; background: #f4f4f5; border-radius: 10px; border: 1.5px solid var(--border); margin-bottom: 10px; }
        .steps strong { display: block; margin-bottom: 4px; }
        .status-line { font-size: 0.75rem; color: var(--muted); text-align: center; margin: 8px 0; font-weight: 700; }
        .pool-scroll { max-height: 200px; overflow-y: auto; margin-bottom: 8px; }
        .draft-banner { padding: 10px; border-radius: 10px; background: #18181b; color: var(--neon); font-weight: 800; font-size: 0.8rem; text-align: center; margin-bottom: 8px; }
        .live-team { padding: 8px; border-radius: 8px; border: 1.5px solid var(--border); margin-bottom: 6px; font-size: 0.72rem; line-height: 1.45; background: #fafafa; }
        .live-team b { font-size: 0.78rem; }
        .team-stat-card { padding: 10px; border-radius: 10px; border: 1.5px solid var(--border); margin-bottom: 8px; background: #fafafa; }
        .team-stat-card.red { border-left: 4px solid var(--red); }
        .team-stat-card.blue { border-left: 4px solid var(--blue); }
        .team-stat-card.yellow { border-left: 4px solid var(--yellow-border); background: linear-gradient(90deg, #fffbeb 0%, #fafafa 28%); }
        .team-stat-card.black { border-left: 4px solid #18181b; }
        .team-stat-card .head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
        .team-stat-card .head h4 { font-size: 0.85rem; font-weight: 900; }
        .team-stat-card .head .val { font-size: 1.05rem; font-weight: 900; }
        .team-stat-card .sub { font-size: 0.72rem; color: var(--muted); margin-bottom: 4px; }
        .team-stat-card .names { font-size: 0.7rem; color: var(--muted); line-height: 1.45; margin-top: 6px; }
        .swap-row { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; }
        .swap-btn { padding: 6px 10px; border-radius: 8px; border: 1.5px solid var(--border); background: #fff; font-size: 0.72rem; font-weight: 800; cursor: pointer; }
        .team-pick { display: flex; align-items: center; justify-content: space-between; padding: 14px; border-radius: 12px; border: 2px solid var(--border); background: #fafafa; font-weight: 900; font-size: 1rem; margin-bottom: 6px; cursor: pointer; }
        .team-pick.picked { background: #fff; }
        .team-pick.red { border-color: var(--red); } .team-pick.red.picked { background: #fef2f2; }
        .team-pick.blue { border-color: var(--blue); } .team-pick.blue.picked { background: #eff6ff; }
        .team-pick.yellow { border-color: var(--yellow-border); } .team-pick.yellow.picked { background: #fffbeb; }
        .team-pick.black { border-color: #18181b; } .team-pick.black.picked { background: #f4f4f5; }
        .team-pick .mark { font-size: 0.78rem; font-weight: 800; color: var(--muted); }
        .pick-status, .flow-note { font-size: 0.75rem; color: var(--muted); text-align: center; font-weight: 700; margin-bottom: 8px; }
        .flow-note { color: var(--blue); padding: 8px; background: #eff6ff; border-radius: 8px; border: 1px solid #bfdbfe; line-height: 1.45; }
        .score-big { text-align: center; font-size: 1.35rem; font-weight: 900; margin: 8px 0 12px; }
        .score-big .sep { margin: 0 8px; }
        .ctrl-row { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
        .timer-box { font-family: ui-monospace, monospace; font-size: 1.2rem; font-weight: 900; padding: 8px 16px; border-radius: 12px; background: #fafafa; border: 1.5px solid var(--border); }
        .btn-sm { min-height: 40px; padding: 8px 12px; border-radius: 10px; border: none; font-size: 0.78rem; font-weight: 800; font-family: inherit; color: #fff; cursor: pointer; }
        .btn-sm.gray { background: #71717a; } .btn-sm.blue { background: var(--blue); }
        .tabs { display: flex; justify-content: space-around; gap: 8px; margin-bottom: 14px; border-bottom: 1.5px solid var(--border); }
        .tabs button { padding: 10px 8px; font-size: 0.78rem; font-weight: 800; color: var(--muted); border: none; background: none; border-bottom: 3px solid transparent; margin-bottom: -1.5px; flex: 1; cursor: pointer; font-family: inherit; }
        .tabs button.on { color: var(--text); border-bottom-color: var(--primary); }
        .tab-pane { display: none; } .tab-pane.on { display: block; }
        .lineup-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .lineup-col { border-radius: 14px; overflow: hidden; border: 1.5px solid var(--border); background: #fff; box-shadow: 0 4px 16px rgba(0,0,0,0.06); }
        .lineup-col .team-head { padding: 10px 8px; text-align: center; font-family: Cinzel, Georgia, serif; font-size: 0.85rem; font-weight: 900; letter-spacing: 0.1em; color: #fff; }
        .lineup-col.team-red .team-head { background: linear-gradient(135deg, #b91c1c, #dc2626); }
        .lineup-col.team-blue .team-head { background: linear-gradient(135deg, #1d4ed8, #2563eb); }
        .lineup-col.team-yellow .team-head { background: linear-gradient(135deg, #eab308, #facc15); color: #422006; }
        .lineup-col.team-black .team-head { background: linear-gradient(135deg, #27272a, #18181b); }
        .lineup-col .roster { padding: 8px 6px 10px; }
        .prow { display: flex; gap: 4px; margin-bottom: 6px; align-items: stretch; }
        .prow .name { flex: 1; text-align: left; padding: 11px 10px; font-size: 0.95rem; font-weight: 900; background: #f8fafc; border: 1.5px solid #e4e4e7; border-radius: 10px; min-height: 46px; display: flex; align-items: center; cursor: pointer; font-family: inherit; }
        .lineup-col.team-red .prow .name { border-left: 3px solid var(--red); }
        .lineup-col.team-blue .prow .name { border-left: 3px solid var(--blue); }
        .lineup-col.team-yellow .prow .name { border-left: 3px solid var(--yellow); }
        .prow .name .cap { font-size: 0.62rem; font-weight: 800; margin-right: 4px; background: #18181b; padding: 2px 5px; border-radius: 4px; color: var(--neon); }
        .btn-sub { width: calc(100% - 12px); min-height: var(--touch-min); margin: 8px 6px 10px; padding: 12px; border: none; border-radius: 12px; background: linear-gradient(135deg, var(--sub) 0%, var(--sub-dark) 100%); color: #fff; font-weight: 900; font-size: var(--font-btn); font-family: inherit; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; }
        .sub-pick { padding: 10px; border-radius: 10px; border: 2px solid var(--border); margin-bottom: 8px; background: #fafafa; }
        .sub-pick.out { border-color: var(--red); background: #fef2f2; }
        .sub-pick.out .lbl { font-size: 0.68rem; color: var(--red); font-weight: 800; margin-bottom: 4px; }
        .sub-pick.out .pname { font-size: 1.15rem; font-weight: 900; }
        .sub-bench { display: flex; flex-direction: column; gap: 6px; margin: 10px 0; }
        .sub-bench button { width: 100%; min-height: 48px; padding: 12px; border-radius: 10px; border: 2px solid var(--border); background: #fff; font-weight: 800; font-size: var(--font-btn); font-family: inherit; text-align: left; cursor: pointer; }
        .sub-bench button.on { border-color: var(--sub); background: #f5f3ff; box-shadow: 0 0 0 3px rgba(124,58,237,0.2); }
        .act2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 12px 0 0; }
        .act2 button { padding: 12px; min-height: var(--touch-min); border: none; border-radius: 12px; font-weight: 800; font-size: var(--font-btn); font-family: inherit; color: #fff; cursor: pointer; }
        .act2 .u { background: #71717a; } .act2 .e { background: var(--primary); }
        .result-hero { padding: 16px 14px; border-radius: 16px; margin-bottom: 12px; background: linear-gradient(145deg, #0c0c0e 0%, #1a1a22 55%, #121218 100%); border: 1.5px solid var(--gold); }
        .result-hero .eyebrow { font-family: Cinzel, Georgia, serif; font-size: 0.72rem; font-weight: 900; letter-spacing: 0.14em; color: var(--gold-light); text-align: center; }
        .result-hero .mvp-names { text-align: center; font-size: 1.2rem; font-weight: 900; color: #fff; margin-top: 10px; }
        .result-hero .mp-plain { text-align: center; margin-top: 8px; color: var(--gold-light); font-size: 0.82rem; font-weight: 800; }
        .award-g { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
        .award { padding: 10px; border-radius: 12px; background: linear-gradient(160deg, #fafafa 0%, #f4f4f5 100%); border: 1.5px solid #e4e4e7; font-size: 0.78rem; font-weight: 700; }
        .award b { display: block; font-size: 0.68rem; color: #57534e; margin-bottom: 4px; font-weight: 800; }
        .result-card { background: #fff; border-radius: 14px; padding: 12px; border: 1.5px solid #e4e4e7; margin-bottom: 10px; overflow-x: auto; }
        .result-card.team-red { border-left: 4px solid var(--red); }
        .result-card.team-blue { border-left: 4px solid var(--blue); }
        .result-card.team-yellow { border-left: 4px solid var(--yellow-border); }
        .result-card.team-black { border-left: 4px solid #18181b; }
        .result-btns { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }
        .warn-banner { font-size: 0.78rem; line-height: 1.5; padding: 10px; border-radius: 10px; background: #fef3c7; border: 1.5px solid #fcd34d; color: #713f12; margin-bottom: 10px; }
        table.data { width: 100%; font-size: 0.68rem; border-collapse: collapse; }
        table.data th, table.data td { padding: 6px 3px; text-align: center; border-bottom: 1px solid var(--border); }
        table.data th { color: var(--muted); font-weight: 800; }
        table.data.rank th, table.data.rank td { padding: 7px 2px; white-space: nowrap; }
        table.data.rank th { font-size: 0.65rem; letter-spacing: -0.03em; }
        table.data.rank .col-team { font-weight: 900; }
        table.edit-stats { width: 100%; font-size: 0.85rem; border-collapse: collapse; }
        table.edit-stats th, table.edit-stats td { padding: 9px 4px; text-align: center; border-bottom: 1px solid var(--border); }
        table.edit-stats .pname { text-align: left; font-weight: 700; }
        table.edit-stats input { width: 48px; min-height: var(--input-h); text-align: center; font-weight: 700; border: 1.5px solid var(--border); border-radius: 8px; }
        .timeline { max-height: 140px; overflow-y: auto; font-size: 0.75rem; line-height: 1.5; }
        .timeline li { border-bottom: 1px solid var(--border); padding: 6px 0; }
        #loading-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.55); display: flex; align-items: center; justify-content: center; z-index: 100; }
        .spinner { width: 48px; height: 48px; border: 4px solid #e4e4e7; border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .modal-overlay { position: fixed; inset: 0; z-index: 90; background: rgba(0,0,0,0.55); display: flex; align-items: center; justify-content: center; padding: 16px; }
        .modal-card { width: 100%; max-width: 300px; background: #fff; border-radius: 16px; padding: 16px; border: 1.5px solid var(--border-strong); box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
        .modal-card h3 { font-size: 1.05rem; font-weight: 900; text-align: center; margin-bottom: 8px; }
        .modal-card .sub { font-size: 0.8rem; color: var(--muted); text-align: center; margin-bottom: 12px; line-height: 1.5; }
        .modal-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .modal-btns button { min-height: 52px; border: none; border-radius: 10px; font-weight: 900; font-size: 0.9rem; font-family: inherit; cursor: pointer; }
        .modal-btns .ok { background: var(--primary); color: #fff; }
        .modal-btns .no { background: #f4f4f5; color: var(--muted); border: 1.5px solid var(--border); }
        .modal-btns .danger { background: #991b1b; color: #fff; }
        .modal-btns .goal, .modal-btns .def, .modal-btns .save { background: #18181b; color: var(--neon); box-shadow: inset 0 1px 0 rgba(163,230,53,0.18), 0 2px 8px rgba(0,0,0,0.25); }
        .modal-btns .og { background: #dc2626; color: #fff; }
        .modal-btns .cancel { grid-column: 1 / -1; background: #f4f4f5; color: var(--muted); border: 1.5px solid var(--border); min-height: 44px; font-size: var(--font-btn); }
        .assist-picks { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 4px; }
        .assist-picks button { padding: 10px 18px; border-radius: 999px; border: 2px solid var(--border-strong); background: #fafafa; color: var(--text); font-weight: 800; font-size: var(--font-btn); font-family: inherit; cursor: pointer; }
        .assist-picks button.on { border-color: var(--green); background: #f0fdf4; color: var(--green-dark); box-shadow: 0 0 0 3px rgba(22,163,74,0.2); }
        .pick-list { display: flex; flex-direction: column; gap: 6px; max-height: 200px; overflow-y: auto; }
        .pick-list button { width: 100%; min-height: 44px; padding: 10px; border-radius: 10px; border: 1.5px solid var(--border); background: #fafafa; font-weight: 800; font-family: inherit; cursor: pointer; text-align: left; }
        .toast { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); background: #991b1b; color: #fff; padding: 12px 20px; border-radius: 12px; font-weight: 800; font-size: 0.9rem; z-index: 110; }
    </style>
</head>
<body>
<div id="loading-overlay"><div class="spinner"></div></div>
<div id="app">
    <div id="screen-attendance" class="screen hidden"></div>
    <div id="screen-coach-select" class="screen hidden"></div>
    <div id="screen-snake-draft" class="screen hidden"></div>
    <div id="screen-team-allocation" class="screen hidden"></div>
    <div id="screen-match-select" class="screen hidden"></div>
