function renderTeamRankingsTable() {
    const { teamStats } = localState.sessionStats;
    const arr = Object.keys(teamStats).filter(t => teamStats[t].matchesPlayed > 0).map(name => {
        const s = teamStats[name];
        return { name, played: s.matchesPlayed, wins: s.wins, draws: s.draws, losses: s.losses, gf: s.goalsFor, ga: s.goalsAgainst, gd: s.goalsFor - s.goalsAgainst, points: s.wins * 3 + s.draws, winRate: formatTeamWinRate(s) };
    }).sort((a, b) => b.points - a.points || b.gd - a.gd || b.gf - a.gf);
    return `<div class="result-card"><table class="data rank"><thead><tr><th>순위</th><th>팀</th><th>경기</th><th>승</th><th>무</th><th>패</th><th>득</th><th>실</th><th>득실</th><th>승률</th><th>승점</th></tr></thead><tbody>
        ${arr.map((t, i) => `<tr><td>${i+1}</td><td class="${teamColorClasses[t.name]} col-team">${t.name}</td><td>${t.played}</td><td>${t.wins}</td><td>${t.draws}</td><td>${t.losses}</td><td>${t.gf}</td><td>${t.ga}</td><td>${t.gd>0?'+':''}${t.gd}</td><td>${t.winRate}</td><td>${t.points}</td></tr>`).join('')}
    </tbody></table></div>`;
}

function renderPlayerStatsRankings() {
    const ps = localState.sessionStats.playerStats;
    const arr = Object.keys(ps).map(n => ({ name: n, ...ps[n] }));
    const rank = (key, n) => [...arr].sort((a,b) => (b[key]||0)-(a[key]||0)).filter(p => (p[key]||0)>0).slice(0, n);
    const mvp = [...arr].sort((a,b) => calcMP(b)-calcMP(a)).filter(p => calcMP(p)>0).slice(0,5);
    const block = (title, list, key) => list.length ? `<div class="card"><h4 style="font-weight:900;margin-bottom:6px">${title}</h4>${list.map((p,i)=>`<div style="display:flex;justify-content:space-between;font-size:0.8rem;padding:4px 0;border-bottom:1px solid var(--border)"><span>${i+1}. ${p.name}</span><span>${p[key]}</span></div>`).join('')}</div>` : '';
    return (mvp.length ? `<div class="card" style="background:#fffbeb;border-color:#fcd34d"><h4 style="font-weight:900;margin-bottom:6px">🏆 MVP</h4>${mvp.map((p,i)=>`<div style="display:flex;justify-content:space-between;font-size:0.8rem;padding:4px 0"><span>${i+1}. ${p.name}</span><span>MP ${calcMP(p)}</span></div>`).join('')}</div>` : '') +
        block('득점', rank('goal',10), 'goal') + block('도움', rank('assist',10), 'assist') + block('수비', rank('defense',10), 'defense') + block('선방', rank('save',10), 'save');
