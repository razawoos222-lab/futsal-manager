<script>
let MASTER_PLAYERS_DB = [], localState = {}, PLAYER_ARCHIVE_STATS = {}, COACH_ARCHIVE_STATS = {};
let timerInterval = null, currentEventData = {}, pageLeaveTime = null, timerWasRunning = false;
let currentGoalkeeperSelectTeam = null, currentPlayerToSwapOut = null, isProcessingEvent = false;
let pendingCoaches = [], pendingCoachSlotIndex = 0;
let summaryEditMode = false, summaryEditTeam = 'RED';

const TEAM_ORDER = ['RED', 'BLUE', 'YELLOW', 'BLACK'];
const teamColorClasses = { RED: 'team-name-RED', BLUE: 'team-name-BLUE', YELLOW: 'team-name-YELLOW', BLACK: 'team-name-BLACK' };
const teamShortClass = { RED: 'red', BLUE: 'blue', YELLOW: 'yellow', BLACK: 'black' };

function getTeamNamesForMode(teamMode) {
    const mode = Number(teamMode) || 3;
    if (mode === 2) return ['RED', 'BLUE'];
    if (mode === 4) return TEAM_ORDER.slice();
    return ['RED', 'BLUE', 'YELLOW'];
}

function getActiveTeamsInOrder() {
    const mode = Number(localState.teamMode) || 3;
    const names = getTeamNamesForMode(mode);
    if (mode === 4) return names.filter(t => localState.teams && localState.teams[t]);
    return names.filter(t => {
        const td = localState.teams[t];
        return td && (td.players.length > 0 || td.goalkeeper);
    });
}

function formatTeamWinRate(stats) {
    const wins = Number(stats.wins) || 0;
    const losses = Number(stats.losses) || 0;
    const played = Number(stats.matchesPlayed) || 0;
    if (wins + losses > 0) return ((wins / (wins + losses)) * 100).toFixed(1) + '%';
    if (played > 0) return '0.0%';
    return '-';
}

function getPositionClass(position) {
    const p = String(position || '').toLowerCase();
    if (p.includes('피보') || p.includes('pivo')) return 'pivo';
    if (p.includes('픽소') || p.includes('fixo')) return 'fixo';
    if (p.includes('아라') || p.includes('ala')) return 'ala';
    return 'all';
}

function getPlayerByName(name) {
    return MASTER_PLAYERS_DB.find(p => p.name === name);
}

function getCcpPerGame(name) {
    const p = getPlayerByName(name);
    if (!p) return 0;
    return Number(p.ccpPerGame ?? p.ccp ?? 0);
}

function calcTeamPower(names) {
    const vals = names.map(getCcpPerGame).filter(v => v > 0);
    if (!vals.length) return 0;
    const avg = vals.reduce((a, b) => a + b, 0) / vals.length;
    return Math.round((avg / 2.5) * 100);
}

function calcTeamAvgWinRate(names) {
    const vals = names.map(n => {
        const p = getPlayerByName(n);
        return p ? (Number(p.winRate) || 0) * 100 : 0;
    }).filter(v => v > 0);
    if (!vals.length) return '-';
    return (vals.reduce((a, b) => a + b, 0) / vals.length).toFixed(1) + '%';
}

function calcMP(s) {
    return ((s.goal || 0) * 2) + ((s.assist || 0) * 2) + ((s.defense || 0) * 1) + ((s.save || 0) * 1);
}

function showToast(msg) {
    const el = document.createElement('div');
    el.className = 'toast';
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 2000);
}

function jmfcBar(subtitle, showBack) {
    const back = showBack ? '<button id="btn-back" data-action="go-back" class="btn-back">←</button>' : '';
    return `<div class="jmfc-bar"><div class="logo-text">JMFC</div><div class="jmfc-brand"><strong>JMFC FOOTBALL</strong><span>${subtitle}</span></div>${back}</div>`;
}

function renderPlayerCard(p, opts = {}) {
    const selected = opts.selected ? ' selected' : '';
    const tap = opts.tap ? ' tap-pick' : '';
    const stats = opts.statsText ? `<div class="stats">${opts.statsText}</div>` : '<div class="stats empty">&nbsp;</div>';
    return `<div data-action="${opts.action || 'toggle-attendance'}" data-player-name="${p.name}" class="pcard ${getPositionClass(p.position)}${selected}${tap}"><div class="name">${p.name}</div><div class="role">${p.position || ''}</div>${stats}</div>`;
}

function serverCall(funcName, ...args) {
    if (typeof google === 'undefined' || !google.script || !google.script.run) {
        console.error('google.script.run unavailable');
        alert('오류: 앱을 로드할 수 없습니다.');
        document.getElementById('loading-overlay').style.display = 'none';
        return Promise.reject(new Error('GAS 환경이 아닙니다.'));
    }
    const showLoading = !['toggleTimerState'].includes(funcName);
    const silentRetry = ['toggleTimerState'].includes(funcName);
    const isLock = m => /다른 작업이 진행 중|잠금|Lock/i.test(String(m || ''));

    function attempt(retryCount) {
        if (showLoading && retryCount === 0) document.getElementById('loading-overlay').style.display = 'flex';
        return new Promise((resolve, reject) => {
            google.script.run
                .withSuccessHandler(response => {
                    if (showLoading) document.getElementById('loading-overlay').style.display = 'none';
                    if (response.success) {
                        if (response.data && response.data.currentScreen) {
                            localState = response.data;
                            renderUI();
                        }
                        resolve(response.data);
                        return;
                    }
                    if (silentRetry && isLock(response.message) && retryCount < 4) {
                        setTimeout(() => attempt(retryCount + 1).then(resolve).catch(reject), 400 * (retryCount + 1));
                        return;
                    }
                    alert('서버 오류: ' + response.message);
                    reject(new Error(response.message));
                })
                .withFailureHandler(error => {
                    if (showLoading) document.getElementById('loading-overlay').style.display = 'none';
                    if (silentRetry && isLock(error.message) && retryCount < 4) {
                        setTimeout(() => attempt(retryCount + 1).then(resolve).catch(reject), 400 * (retryCount + 1));
                        return;
                    }
                    alert('통신 오류: ' + error.message);
                    reject(error);
                })[funcName](...args);
        });
    }
    return attempt(0);
}

function startTimer() {
    if (timerInterval) clearInterval(timerInterval);
    serverCall('toggleTimerState', true);
    let seconds = localState.match.seconds;
    timerInterval = setInterval(() => {
        seconds = Math.max(0, seconds - 1);
        localState.match.seconds = seconds;
        updateTimerDisplay(seconds);
        if (seconds <= 0) pauseTimer();
    }, 1000);
}

function pauseTimer() {
    clearInterval(timerInterval);
    timerInterval = null;
    serverCall('toggleTimerState', false, localState.match.seconds).then(() => {
        const btn = document.querySelector('#screen-match-controller [data-action="toggle-timer"]');
        if (btn) { btn.textContent = '시작'; btn.className = 'btn-sm blue'; }
    });
}

function updateTimerDisplay(seconds) {
    const d = document.getElementById('timer-display');
    if (!d) return;
    const m = Math.floor(seconds / 60).toString().padStart(2, '0');
    const s = (seconds % 60).toString().padStart(2, '0');
    d.textContent = m + ':' + s;
}

function saveTimerStateBeforeLeave() {
    if (localState.currentScreen === 'screen-match-controller' && localState.match) {
        pageLeaveTime = Date.now();
        timerWasRunning = localState.match.timerRunning;
    }
}

function recoverTimerIfNeeded() {
    if (pageLeaveTime && timerWasRunning && localState.match && localState.match.seconds > 0) {
        const elapsed = Math.floor((Date.now() - pageLeaveTime) / 1000);
        localState.match.seconds = Math.max(0, localState.match.seconds - elapsed);
        if (localState.match.seconds > 0 && localState.match.timerRunning) startTimer();
        else if (localState.match.seconds <= 0) pauseTimer();
    }
    pageLeaveTime = null;
    timerWasRunning = false;
}

const VALID_SCREENS = [
    'screen-attendance', 'screen-coach-select', 'screen-snake-draft', 'screen-team-allocation',
    'screen-match-select', 'screen-match-controller', 'screen-substitute',
    'screen-session-summary', 'screen-coach-ranking', 'screen-final-results'
];

const SCREEN_SUBTITLES = {
    'screen-attendance': '참석 조사',
    'screen-coach-select': 'Draft',
    'screen-snake-draft': 'Draft',
    'screen-team-allocation': '확정',
    'screen-match-select': '경기 선택',
    'screen-match-controller': 'Match #' + (localState.match?.count || 1),
    'screen-substitute': '선수교체',
    'screen-session-summary': '세션 종료',
    'screen-coach-ranking': '감독 랭킹',
    'screen-final-results': '저장 완료'
};

function getBackTarget(screen) {
    const hasMatch = localState.match?.teamA?.name && localState.match?.teamB?.name;
    const map = {
        'screen-coach-select': 'screen-attendance',
        'screen-snake-draft': 'screen-coach-select',
        'screen-team-allocation': localState.draft ? 'screen-snake-draft' : 'screen-coach-select',
        'screen-match-select': (localState.match?.count > 1 && hasMatch) ? 'screen-match-controller' : 'screen-team-allocation',
        'screen-match-controller': 'screen-match-select',
        'screen-substitute': 'screen-match-controller',
        'screen-session-summary': 'screen-match-select',
        'screen-coach-ranking': 'screen-session-summary'
    };
    return map[screen] || 'screen-attendance';
}

function renderUI() {
    let { currentScreen } = localState;
    if (!VALID_SCREENS.includes(currentScreen)) {
        currentScreen = 'screen-attendance';
        localState.currentScreen = currentScreen;
    }
    document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
    const el = document.getElementById(currentScreen);
    if (!el) return;
    el.classList.remove('hidden');
    const showBack = !['screen-attendance', 'screen-final-results'].includes(currentScreen);
    const renderers = {
        'screen-attendance': renderAttendanceScreen,
        'screen-coach-select': renderCoachSelectScreen,
        'screen-snake-draft': renderSnakeDraftScreen,
        'screen-team-allocation': renderAllocationScreen,
        'screen-match-select': renderMatchSelectScreen,
        'screen-match-controller': renderMatchControllerScreen,
        'screen-substitute': renderSubstituteScreen,
        'screen-session-summary': renderSessionSummaryScreen,
        'screen-coach-ranking': renderCoachRankingScreen,
        'screen-final-results': renderFinalResultsScreen
    };
    if (renderers[currentScreen]) renderers[currentScreen](showBack);
    const backBtn = document.getElementById('btn-back');
    if (backBtn) backBtn.dataset.targetScreen = getBackTarget(currentScreen);
}

function renderAttendanceScreen(showBack) {
    const el = document.getElementById('screen-attendance');
    const mode = Number(localState.teamMode) || 3;
    const players = MASTER_PLAYERS_DB.map(p => renderPlayerCard(p, {
        selected: localState.attendingPlayerNames.includes(p.name)
    })).join('');
    el.innerHTML = jmfcBar('참석 조사', showBack) + `<div class="body scroll"><h2>참석 조사</h2>
        <label class="lbl-sm">날짜</label>
        <input type="date" id="game-date" class="field" value="${localState.selectedDate || ''}">
        <label class="lbl-sm" style="margin-top:10px">팀 구성</label>
        <div class="seg" id="team-mode-seg">
            ${[2,3,4].map(m => `<button type="button" data-action="set-team-mode" data-mode="${m}" class="${mode===m?'on':''}">${m}팀</button>`).join('')}
        </div>
        <div class="chip-row">
            <span class="chip">참석 <span id="attendance-count">${localState.attendingPlayerNames.length}</span>명</span>
            <span class="chip" data-action="select-all-attendance">전체 선택</span>
            <span class="chip" data-action="clear-all-attendance">전체 해제</span>
        </div>
        <div class="grid2 attend" id="master-player-list">${players}</div>
        <button data-action="go-to-allocation" class="btn-cta">참석 완료 → Draft</button>
    </div>`;
}

function initPendingCoaches() {
    const teams = getTeamNamesForMode(localState.teamMode);
    pendingCoaches = teams.map(t => localState.teams[t]?.coach || null);
    pendingCoachSlotIndex = pendingCoaches.findIndex(c => !c);
    if (pendingCoachSlotIndex < 0) pendingCoachSlotIndex = 0;
}

function renderCoachSelectScreen(showBack) {
    initPendingCoaches();
    const teams = getTeamNamesForMode(localState.teamMode);
    const filled = pendingCoaches.filter(Boolean).length;
    const currentTeam = teams[pendingCoachSlotIndex];
    const slots = teams.map((t, i) => {
        const coach = pendingCoaches[i];
        const tc = teamShortClass[t];
        const filledCls = coach ? ` filled-${tc}` : '';
        const pickCls = i === pendingCoachSlotIndex ? ' pick-target' : '';
        return `<div data-action="pick-coach-slot" data-slot-index="${i}" class="coach-slot${filledCls}${pickCls}"><span>TEAM ${t}</span><span class="slot-name">${coach || '감독?'}</span></div>`;
    }).join('');
    const assigned = new Set(pendingCoaches.filter(Boolean));
    const pool = MASTER_PLAYERS_DB.filter(p => localState.attendingPlayerNames.includes(p.name) && !assigned.has(p.name));
    const poolHtml = pool.map(p => renderPlayerCard(p, { action: 'assign-coach', tap: false })).join('');
    const ready = pendingCoaches.every(Boolean);
    document.getElementById('screen-coach-select').innerHTML = jmfcBar('Draft', showBack) + `<div class="body scroll">
        <h2>감독 ${teams.length}명 선택</h2>
        <div class="steps"><strong>방법</strong>① 감독 자리 탭 → ② 선수 카드 탭 → ③ ${teams.length}팀 완료</div>
        <p class="status-line">${filled}/${teams.length} · TEAM ${currentTeam} 감독 자리 선택 중</p>
        <div class="coach-slots">${slots}</div>
        <p class="lbl-sm">참석 선수 전원</p>
        <div class="pool-scroll"><div class="grid2">${poolHtml}</div></div>
        <button data-action="start-snake-draft" class="btn-cta" ${ready ? '' : 'disabled'}>드래프트 시작 ${ready ? '' : `(${teams.length}명 필요)`}</button>
    </div>`;
}

function renderSnakeDraftScreen(showBack) {
    const draft = localState.draft;
    if (!draft) {
        document.getElementById('screen-snake-draft').innerHTML = jmfcBar('Draft', showBack) + '<div class="body"><p class="status-line">드래프트 정보가 없습니다.</p></div>';
        return;
    }
    const teams = getTeamNamesForMode(localState.teamMode);
    const currentTeam = draft.pickOrder[draft.pickIndex] || '';
    const pool = draft.pool || [];
    const live = teams.map(t => {
        const td = localState.teams[t];
        const all = [...(td.players || [])];
        const coach = td.coach;
        const names = coach ? [`${coach}(C)`, ...all.filter(p => p !== coach)] : all;
        return `<div class="live-team"><b class="${teamColorClasses[t]}">TEAM ${t} ${all.length}/8</b> · ${names.join(' · ') || '—'}</div>`;
    }).join('');
    const poolHtml = pool.map(name => {
        const p = getPlayerByName(name) || { name, position: '' };
        const wr = getPlayerByName(name);
        const statsText = wr && wr.winRate ? `승률 ${(wr.winRate * 100).toFixed(0)}%` : '';
        return renderPlayerCard(p, { action: 'snake-pick', statsText });
    }).join('');
    document.getElementById('screen-snake-draft').innerHTML = jmfcBar('Draft', showBack) + `<div class="body scroll">
        <div class="draft-banner">TEAM ${currentTeam} 차례 · 남은 ${pool.length}명</div>
        <div class="live-teams">${live}</div>
        <p class="lbl-sm">미배정 선수 · 탭하면 즉시 팀 편성</p>
        <div class="pool-scroll"><div class="grid2">${poolHtml}</div></div>
        <button data-action="undo-snake-pick" class="btn-sec">↩ 마지막 픽 취소</button>
    </div>`;
}

function renderAllocationScreen(showBack) {
    const teams = getTeamNamesForMode(localState.teamMode).filter(t => localState.teams[t]);
    const cards = teams.map(t => {
        const td = localState.teams[t];
        const all = [...td.players, td.goalkeeper].filter(Boolean);
        const coach = td.coach;
        const names = td.players.map(p => {
            const cap = p === td.captain ? '(C)' : (p === td.viceCaptain ? '(VC)' : '');
            return p + cap;
        });
        if (coach && !names.includes(coach + '(C)')) names.unshift(coach + '(C)');
        const swapBtns = td.players.map(p => `<button data-action="open-swap-modal" data-player-name="${p}" data-team-name="${t}" class="swap-btn">${p} ↔</button>`).join('');
        const power = calcTeamPower(all);
        const wr = calcTeamAvgWinRate(all);
        const valCls = 'val-' + (teamShortClass[t] || 'red');
        return `<div class="team-stat-card ${teamShortClass[t]}">
            <div class="head"><h4 class="${teamColorClasses[t]}">TEAM ${t} ${all.length}명</h4><span class="val ${valCls}">팀파워 ${power}</span></div>
            <div class="sub">팀 승률 <b>${wr}</b>${coach ? ` · 감독 <b>${coach}</b>` : ''}</div>
            <div class="names">${names.join(' · ') || '—'}</div>
            <div class="swap-row">${swapBtns}</div>
        </div>`;
    }).join('');
    document.getElementById('screen-team-allocation').innerHTML = jmfcBar('확정', showBack) + `<div class="body scroll">
        <h2>${teams.length}팀 라인업</h2>
        ${cards}
        <button data-action="go-to-match-select" class="btn-cta">팀 구성 확정 → 경기 선택</button>
    </div>`;
}

function renderMatchSelectScreen(showBack) {
    const active = getActiveTeamsInOrder();
    const selected = localState.match.playingTeams || [];
    const dur = localState.match.selectedDuration || 600;
