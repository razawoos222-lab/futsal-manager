function getTopTies(statKey, max = 8) {
    const ps = localState.sessionStats.playerStats;
    let maxVal = -1;
    Object.keys(ps).forEach(n => { const v = ps[n]?.[statKey] || 0; if (v > maxVal) maxVal = v; });
    if (maxVal <= 0) return { maxVal: 0, names: [] };
    return { maxVal, names: Object.keys(ps).filter(n => (ps[n]?.[statKey]||0) === maxVal).slice(0, max) };
}

function getTopMvpTies(max = 8) {
    const ps = localState.sessionStats.playerStats;
    let maxMp = -1;
    Object.keys(ps).forEach(n => { const mp = calcMP(ps[n]||{}); if (mp > maxMp) maxMp = mp; });
    if (maxMp <= 0) return { maxMp: 0, names: [] };
    return { maxMp, names: Object.keys(ps).filter(n => calcMP(ps[n]||{}) === maxMp).slice(0, max) };
}

