function getBenchForTeam(teamName) {
    const onField = new Set(localState.teams[teamName].players);
    const options = [];
    getTeamNamesForMode(localState.teamMode).forEach(t => {
        if (t === teamName) return;
        localState.teams[t].players.forEach(p => { if (!onField.has(p)) options.push({ name: p, from: t }); });
        if (localState.teams[t].goalkeeper) options.push({ name: localState.teams[t].goalkeeper, from: t + ' GK' });
    });
    localState.attendingPlayerNames.forEach(p => {
        const onAny = getTeamNamesForMode(localState.teamMode).some(t => localState.teams[t].players.includes(p) || localState.teams[t].goalkeeper === p);
        if (!onAny && !onField.has(p)) options.push({ name: p, from: '대기' });
    });
    return options;
}

