    const { action, playerName, teamName, stat, assistPlayerName, gkPlayerName, swapInPlayerName, confirm: isConfirmed } = target.dataset;
    const slotIndex = target.dataset.slotIndex;
    const mode = target.dataset.mode;
    const tab = target.dataset.tab;
    const editPlayer = target.dataset.editPlayer;
    const editStat = target.dataset.editStat;
    const addTeamName = target.dataset.addTeamName;
    const addPlayerName = target.dataset.addPlayerName;
    const fromTeam = target.dataset.fromTeam;
    const waitingTeam = target.dataset.waitingTeam;

    switch (action) {
        case 'go-back':
            if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
            saveTimerStateBeforeLeave();
            const bt = document.getElementById('btn-back')?.dataset?.targetScreen;
            if (bt) serverCall('changeScreen', bt);
            break;
        case 'set-team-mode':
            localState.teamMode = parseInt(mode, 10);
            renderAttendanceScreen(false);
            break;
        case 'toggle-attendance': {
            const names = localState.attendingPlayerNames;
            const idx = names.indexOf(playerName);
            if (idx > -1) names.splice(idx, 1); else names.push(playerName);
            renderAttendanceScreen(false);
            break;
        }
        case 'select-all-attendance':
            localState.attendingPlayerNames = MASTER_PLAYERS_DB.map(p => p.name);
            renderAttendanceScreen(false);
            break;
        case 'clear-all-attendance':
            localState.attendingPlayerNames = [];
            renderAttendanceScreen(false);
            break;
        case 'go-to-allocation':
            if (localState.attendingPlayerNames.length < 2) return alert('최소 2명 이상 선택해주세요.');
            try {
                const date = document.getElementById('game-date')?.value || localState.selectedDate;
                localState.selectedDate = date;
                await serverCall('setAttendingPlayersAndDate', localState.attendingPlayerNames, date, localState.teamMode);
                await serverCall('changeScreen', 'screen-coach-select');
            } catch (err) { console.error(err); }
            break;
        case 'pick-coach-slot':
            pendingCoachSlotIndex = parseInt(slotIndex, 10);
            renderCoachSelectScreen(true);
            break;
        case 'assign-coach': {
            const existing = pendingCoaches.indexOf(playerName);
            if (existing >= 0) pendingCoaches[existing] = null;
            pendingCoaches[pendingCoachSlotIndex] = playerName;
            const next = pendingCoaches.findIndex(c => !c);
            pendingCoachSlotIndex = next >= 0 ? next : pendingCoachSlotIndex;
            renderCoachSelectScreen(true);
            break;
        }
        case 'start-snake-draft':
            if (!pendingCoaches.every(Boolean)) return alert('모든 감독 자리를 채워주세요.');
            try {
                await serverCall('setCoaches', pendingCoaches);
                await serverCall('initSnakeDraft');
            } catch (err) { console.error(err); }
            break;
        case 'snake-pick':
            try {
                const result = await serverCall('snakeDraftPick', playerName);
                if (result?.draft?.pool?.length === 0) await serverCall('finalizeSnakeDraft');
            } catch (err) { console.error(err); }
            break;
        case 'undo-snake-pick':
            serverCall('undoSnakeDraftPick');
            break;
        case 'go-to-match-select':
            serverCall('changeScreen', 'screen-match-select');
            break;
        case 'toggle-team-select': {
            let pts = [...(localState.match.playingTeams || [])];
            if (pts.includes(teamName)) pts = pts.filter(t => t !== teamName);
            else pts.push(teamName);
            if (pts.length > 2) return alert('정확히 2팀만 선택하세요.');
            localState.match.playingTeams = pts;
            renderMatchSelectScreen(true);
            break;
        }
        case 'start-selected-match': {
            if ((localState.match.playingTeams||[]).length !== 2) return alert('2팀을 선택하세요.');
            const dur = parseInt(document.getElementById('match-duration')?.value || localState.match.selectedDuration, 10);
            const field = document.getElementById('field-select')?.value || localState.selectedField;
            localState.selectedField = field;
            serverCall('startMatch', localState.match.playingTeams, dur, field);
            break;
        }
        case 'restore-original-teams':
            if (confirm('원래 팀 구성으로 복구하시겠습니까?')) serverCall('restoreOriginalTeams');
            break;
        case 'open-record-modal':
            if (!localState.match.timerRunning && localState.match.seconds > 0) { showToast('타이머를 먼저 시작해주세요!'); return; }
            currentEventData = { player: playerName, teamName };
            document.getElementById('record-event-title').textContent = `${playerName} (TEAM ${teamName})`;
            document.getElementById('record-event-modal').classList.remove('hidden');
            break;
        case 'close-modal':
            target.closest('.modal-overlay')?.classList.add('hidden');
            break;
        case 'record-event':
            if (isProcessingEvent) return;
            isProcessingEvent = true;
            if (stat === 'goal') {
                document.getElementById('record-event-modal').classList.add('hidden');
                document.getElementById('assist-scorer-name').textContent = currentEventData.player;
                const opts = localState.teams[currentEventData.teamName].players.filter(p => p !== currentEventData.player);
                opts.push('없음');
                document.getElementById('assist-player-list').innerHTML = opts.map(p => `<button data-action="select-assist-player" data-assist-player-name="${p}" class="${p==='없음'?'on':''}">${p}</button>`).join('');
                document.getElementById('assist-select-modal').classList.remove('hidden');
                isProcessingEvent = false;
            } else {
                serverCall('recordEvent', { ...currentEventData, stat }, localState.match.seconds).finally(() => { isProcessingEvent = false; });
                target.closest('.modal-overlay')?.classList.add('hidden');
            }
            break;
        case 'select-assist-player':
            if (isProcessingEvent) return;
            isProcessingEvent = true;
            serverCall('recordEvent', { ...currentEventData, stat: 'goal', assistPlayer: assistPlayerName === '없음' ? null : assistPlayerName }, localState.match.seconds)
                .finally(() => { isProcessingEvent = false; });
            document.getElementById('assist-select-modal').classList.add('hidden');
            break;
        case 'close-assist-modal':
            document.getElementById('assist-select-modal').classList.add('hidden');
            break;
        case 'open-gk-modal':
            currentGoalkeeperSelectTeam = teamName;
            document.getElementById('gk-team-name').textContent = 'TEAM ' + teamName;
            const allTeams = getTeamNamesForMode(localState.teamMode);
            const waiting = localState.attendingPlayerNames.filter(n => !allTeams.some(t => localState.teams[t].players.includes(n) || localState.teams[t].goalkeeper === n));
            const field = localState.teams[teamName].players;
            let gkHtml = '';
            if (field.length) { gkHtml += field.map(p => `<button data-action="select-goalkeeper" data-gk-player-name="${p}">${p}</button>`).join(''); }
            if (waiting.length) { gkHtml += waiting.map(p => `<button data-action="select-goalkeeper" data-gk-player-name="${p}">${p} (대기)</button>`).join(''); }
            gkHtml += `<button data-action="select-goalkeeper" data-gk-player-name="null" style="color:var(--red)">키퍼 해제</button>`;
            document.getElementById('gk-player-list').innerHTML = gkHtml;
            document.getElementById('goalkeeper-select-modal').classList.remove('hidden');
            break;
        case 'select-goalkeeper':
            await serverCall('setGoalkeeper', currentGoalkeeperSelectTeam, gkPlayerName === 'null' ? null : gkPlayerName);
            document.getElementById('goalkeeper-select-modal').classList.add('hidden');
            break;
        case 'close-gk-modal':
            document.getElementById('goalkeeper-select-modal').classList.add('hidden');
            break;
        case 'open-swap-modal':
            currentPlayerToSwapOut = { player: playerName, team: teamName, isGoalkeeper: localState.teams[teamName].goalkeeper === playerName };
            document.getElementById('swap-out-player-info').textContent = `${playerName} (TEAM ${teamName}) ➡️`;
            let swapHtml = '';
            getTeamNamesForMode(localState.teamMode).forEach(ot => {
                if (ot === teamName) return;
                const pl = [...localState.teams[ot].players, localState.teams[ot].goalkeeper].filter(Boolean);
                if (pl.length) swapHtml += pl.map(p => `<button data-action="select-swap-player" data-swap-in-player-name="${p}">${p} (${ot})</button>`).join('');
            });
            const waitSwap = localState.attendingPlayerNames.filter(n => !getTeamNamesForMode(localState.teamMode).some(t => localState.teams[t].players.includes(n) || localState.teams[t].goalkeeper === n));
            if (waitSwap.length) swapHtml += waitSwap.map(p => `<button data-action="select-swap-player" data-swap-in-player-name="${p}">${p} (대기)</button>`).join('');
            if (!currentPlayerToSwapOut.isGoalkeeper) swapHtml += `<button data-action="select-swap-player" data-swap-in-player-name="null" style="color:var(--red)">선수 제거</button>`;
            document.getElementById('swap-in-player-list').innerHTML = swapHtml;
            document.getElementById('player-swap-modal').classList.remove('hidden');
            break;
        case 'select-swap-player':
            if (currentPlayerToSwapOut) await serverCall('substitutePlayer', currentPlayerToSwapOut.team, currentPlayerToSwapOut.player, swapInPlayerName === 'null' ? null : swapInPlayerName);
            document.getElementById('player-swap-modal').classList.add('hidden');
            break;
        case 'close-swap-modal':
            document.getElementById('player-swap-modal').classList.add('hidden');
            break;
        case 'open-add-modal':
            document.getElementById('add-player-modal-title').innerHTML = `<span class="${teamColorClasses[waitingTeam]}">TEAM ${waitingTeam}</span> 에서 추가`;
            document.getElementById('add-player-list').innerHTML = (localState.teams[waitingTeam]?.players||[]).map(p =>
                `<button data-action="select-add-player" data-add-team-name="${teamName}" data-add-player-name="${p}" data-from-team="${waitingTeam}">${p}</button>`).join('');
            document.getElementById('player-add-modal').classList.remove('hidden');
            break;
        case 'select-add-player':
            await serverCall('addPlayerToTeam', addTeamName, addPlayerName, fromTeam);
            document.getElementById('player-add-modal').classList.add('hidden');
            break;
        case 'close-add-modal':
            document.getElementById('player-add-modal').classList.add('hidden');
            break;
        case 'open-substitute-screen':
            localState.substituteContext = { team: teamName, out: null, in: undefined };
            serverCall('changeScreen', 'screen-substitute');
            break;
        case 'sub-pick-out':
            localState.substituteContext = { ...localState.substituteContext, out: playerName, in: undefined };
            renderSubstituteScreen(true);
            break;
        case 'sub-pick-in':
            localState.substituteContext = { ...localState.substituteContext, in: playerName };
            renderSubstituteScreen(true);
            break;
        case 'confirm-substitute': {
            const ctx = localState.substituteContext;
            const inn = ctx.in === 'null' ? null : ctx.in;
            await serverCall('substitutePlayer', ctx.team, ctx.out, inn);
            localState.substituteContext = null;
            await serverCall('changeScreen', 'screen-match-controller');
            break;
        }
        case 'cancel-substitute':
            localState.substituteContext = null;
            serverCall('changeScreen', 'screen-match-controller');
            break;
        case 'toggle-timer':
            if (localState.match.timerRunning) pauseTimer(); else startTimer();
            break;
        case 'undo':
            if (confirm('마지막 기록을 되돌리시겠습니까?')) serverCall('undoLastEvent');
            break;
        case 'end-match':
            if (confirm('현재 경기를 종료하시겠습니까?')) {
                if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
                serverCall('endMatch');
            }
            break;
        case 'finish-session-to-summary':
            document.getElementById('confirm-session-end-modal-text').innerHTML = '오늘의 모든 경기를 끝내고<br>기록을 저장하시겠습니까?';
            document.getElementById('confirm-session-end-modal').classList.remove('hidden');
            break;
        case 'confirm-session-end':
            document.getElementById('confirm-session-end-modal').classList.add('hidden');
            if (isConfirmed === 'true') serverCall('finishSessionToSummary');
            break;
        case 'toggle-summary-edit':
            summaryEditMode = true;
            summaryEditTeam = getTeamNamesForMode(localState.teamMode).find(t => localState.teams[t]) || 'RED';
            renderSessionSummaryScreen(true);
            break;
        case 'edit-team-tab':
            summaryEditTeam = teamName;
            renderSessionSummaryScreen(true);
            break;
        case 'save-summary-edits': {
            const inputs = document.querySelectorAll('[data-edit-player]');
            const updates = [];
            inputs.forEach(inp => updates.push(serverCall('updateSessionPlayerStats', inp.dataset.editPlayer, inp.dataset.editStat, inp.value)));
            await Promise.all(updates);
            summaryEditMode = false;
            renderSessionSummaryScreen(true);
            break;
        }
        case 'open-save-modal':
            document.getElementById('confirm-save-modal').classList.remove('hidden');
            break;
        case 'close-save-modal':
            document.getElementById('confirm-save-modal').classList.add('hidden');
            break;
        case 'confirm-save-session':
            document.getElementById('confirm-save-modal').classList.add('hidden');
            try {
                await serverCall('updateAndArchiveSession');
                const fresh = await serverCall('getInitialData');
                MASTER_PLAYERS_DB = fresh.masterPlayers || MASTER_PLAYERS_DB;
                COACH_ARCHIVE_STATS = fresh.coachArchiveStats || {};
                PLAYER_ARCHIVE_STATS = fresh.playerArchiveStats || {};
                localState = fresh.appState;
                localState.currentScreen = 'screen-coach-ranking';
                renderUI();
            } catch (err) { console.error(err); }
            break;
        case 'open-reset-modal':
            document.getElementById('confirm-reset-modal').classList.remove('hidden');
            break;
        case 'close-reset-modal':
            document.getElementById('confirm-reset-modal').classList.add('hidden');
            break;
        case 'confirm-reset-session':
            document.getElementById('confirm-reset-modal').classList.add('hidden');
            serverCall('resetSession');
            break;
        case 'go-final-results':
            localState.currentScreen = 'screen-final-results';
            renderUI();
            break;
        case 'reset':
            if (confirm('새 세션을 시작하시겠습니까?')) serverCall('resetSession');
            break;
        case 'select-next-team':
            document.getElementById('select-next-team-modal').classList.add('hidden');
            await serverCall('selectNextPlayingTeam', teamName);
            break;
        case 'confirm-next-match':
            document.getElementById('confirm-next-match-modal').classList.add('hidden');
            await serverCall('confirmNextMatch', isConfirmed === 'true');
            break;
    }
});

document.body.addEventListener('change', e => {
    if (e.target.id === 'game-date') localState.selectedDate = e.target.value;
    if (e.target.id === 'field-select') localState.selectedField = e.target.value;
});

document.body.addEventListener('click', e => {
    const tabBtn = e.target.closest('#match-tabs [data-tab]');
    if (!tabBtn) return;
    document.querySelectorAll('#match-tabs button').forEach(b => b.classList.remove('on'));
    document.querySelectorAll('#screen-match-controller .tab-pane').forEach(p => p.classList.remove('on'));
    tabBtn.classList.add('on');
    const pane = document.getElementById('tab-' + tabBtn.dataset.tab);
    if (pane) pane.classList.add('on');
});

document.addEventListener('visibilitychange', () => {
    if (document.hidden) saveTimerStateBeforeLeave();
    else recoverTimerIfNeeded();
});
window.addEventListener('beforeunload', saveTimerStateBeforeLeave);

</script>
</body>
</html>
